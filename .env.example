# ====================================================================
# OKX API（私有接口必填，公共接口留空）
# ====================================================================
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_IS_DEMO=false

# ====================================================================
# 执行模式控制
# MCP_EXECUTION_ENABLED=false  → 强制只读（最高优先级）
# OKX_READ_ONLY=true           → 只读模式（禁止下单/提现）
# MCP_READONLY_MODE=true       → 同上，别名
# ====================================================================
# MCP_EXECUTION_ENABLED=true
# OKX_READ_ONLY=false
# MCP_READONLY_MODE=false

# ====================================================================
# GitHub（VBT PRO 安装 / Agent 反馈 Issue）
# ====================================================================
GITHUB_TOKEN=

# ====================================================================
# LLM（Chat UI 代理用 / AI SDK 多模型降级链）
# 根据需要选择以下一种或多种通道
# ====================================================================

# --- OpenAI 兼容通道（Chat UI 代理用）---
# 可用提供方：OpenAI / DeepSeek / Groq / Ollama
# OPENAI_BASE_URL=https://api.openai.com/v1    # 默认 OpenAI
# OPENAI_BASE_URL=https://api.deepseek.com/v1  # DeepSeek（中文好，便宜）
# OPENAI_BASE_URL=https://api.groq.com/openai/v1  # Groq（免费额度，极快）
# OPENAI_BASE_URL=http://localhost:11434/v1    # Ollama 本地（免费）
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini                         # 默认模型

# --- DeepSeek 原生通道（VBT Worker / AI 值守 / 降级链 Primary）---
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# DEEPSEEK_MODEL=claude-sonnet-4-6

# --- Anthropic 原生通道（降级链 Secondary，稳定性最佳）---
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Groq 通道（降级链 Tertiary，速度快）---
# 注意：Groq 使用 OpenAI 协议，当前 SDK 仅支持 Anthropic 协议
# Groq 通道已禁用，待 OpenAI 协议适配完成后启用
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-4-scout-17b-16e-instruct

# --- LLM 降级控制 ---
# LLM_FALLBACK=false   # 设为 false 禁用自动降级

# ====================================================================
# H Rails P1（OKX Outcomes 预测市场）
# ====================================================================
HRAILS_API_KEY=
HRAILS_BASE_URL=https://api-staging.hwallet.vip

# ====================================================================
# Figma API（MCP 设计稿导入用）
# ====================================================================
# FIGMA_API_KEY=

# ====================================================================
# 鉴权令牌（HTTP/WS 模式必填，留空则不启用鉴权）
# ====================================================================
MCP_AUTH_TOKEN=
HUB_AUTH_TOKEN=

# ====================================================================
# Agent Hub 服务器
# ====================================================================
# HUB_PORT=9321                  # WebSocket 端口
# HUB_HOST=127.0.0.1             # 绑定地址
# HUB_WEB_PORT=3000              # HTTP 仪表盘端口
# HUB_DB_PATH=.hub/hub.db        # SQLite 任务持久化路径
# HUB_MEMORY_DB=.hub/memory.db   # 共享记忆 SQLite 路径
# HUB_REGISTRY_DB=.hub/registry.db  # 插件商店 SQLite 路径
# HUB_COSTS_DB=.hub/llm-costs.jsonl  # LLM 成本记录 JSONL 路径
# HUB_SPAWN_MCP=1                # 设为 1 则 Hub 自动启动 MCP 子进程

# ====================================================================
# Chronos AI 调度官
# ====================================================================
# CHRONOS_INTERVAL=60000         # 任务调度轮询间隔 (ms)，默认 60s
# CHRONOS_PATROL_INTERVAL=300000 # AI 巡检间隔 (ms)，默认 5min

# ====================================================================
# Worker v2 执行引擎
# ====================================================================
# WORKER_NAME=Atlas              # Worker 显示名称
# WORKER_PROFILE=general         # Worker 能力档案: general/code/quant/guard
# WORKER_MAX_TOKENS=8000         # 单次任务最大 token 数
# WORKER_MAX_STEPS=15            # 单次任务最大 tool-call 步数
# HUB_WORKER_TIMEOUT=600000      # v1 Worker 超时 (ms)，默认 10min

# ====================================================================
# AI Trader 交易引擎
# ====================================================================
# AI_TRADER_MODE=simulate        # 交易模式: simulate | demo | live
# TRADER_INTERVAL=3600000        # 交易轮次间隔 (ms)，默认 1h
# TRADER_MAX_ORDER_USD=100       # 单笔最大下单金额 (USD)
# TRADER_DAILY_LOSS_LIMIT=500    # 日亏损熔断阈值 (USD)

# ====================================================================
# 告警与成本控制
# ====================================================================
# HUB_ALERT_WEBHOOK=             # Discord/Slack Webhook URL（留空不告警）
# HUB_DAILY_BUDGET=5.00          # 每日 LLM 成本预算 (USD)
# HUB_QUEUE_WARN=10              # 任务队列深度告警阈值

# ====================================================================
# 系统
# ====================================================================
# LOG_LEVEL=INFO                 # 日志级别: DEBUG | INFO | WARN | ERROR | SILENT
